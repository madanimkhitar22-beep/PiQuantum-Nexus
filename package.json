{
  "name": "piquantum-nexus",
  "version": "0.1.0",
  "description": "Quantum-secure decentralized intelligence layer for the Pi Network",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "webpack --mode production",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "ts-node src/backend/server.ts",
    "dev:frontend": "webpack serve --mode development",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "quantum",
    "security",
    "pi-network",
